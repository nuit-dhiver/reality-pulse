---
import '../styles/global.css';
import { withBase } from '../utils/paths';

interface Props {
	title: string;
	description?: string;
}

const { title, description = 'A macOS photogrammetry queue for Apple Object Capture.' } = Astro.props;
const siteTitle = title === 'Reality Pulse' ? title : `${title} · Reality Pulse`;
const homePath = withBase();
const docsPath = withBase('docs/');
---

<!doctype html>
<html lang="en">
	<head>
		<meta charset="UTF-8" />
		<meta name="viewport" content="width=device-width, initial-scale=1" />
		<meta name="description" content={description} />
		<meta name="google-site-verification" content="00gqfLgTIf08dbRCBeWTmmhY9XE2PWoxvFAUlT7HpkE" />
		<link rel="icon" type="image/svg+xml" href={withBase('favicon.svg')} />
		<title>{siteTitle}</title>
	</head>
	<body>
		<header class="site-header">
			<div class="container">
				<a class="logo" href={homePath}>
					<img class="logo-mark" src={withBase('favicon.svg')} alt="" width="28" height="28" />
					<span>Reality Pulse</span>
				</a>
				<nav class="site-nav" aria-label="Main">
					<a href={homePath} aria-current={Astro.url.pathname === homePath || Astro.url.pathname === withBase('index.html') ? 'page' : undefined}>Home</a>
					<a href={docsPath} aria-current={Astro.url.pathname.startsWith(docsPath) ? 'page' : undefined}>Docs</a>
					<a href="https://github.com/nuit-dhiver/reality-pulse">GitHub</a>
				</nav>
			</div>
		</header>

		<main>
			<slot />
		</main>

		<footer class="site-footer">
			<div class="container">
				<p>Reality Pulse — macOS photogrammetry queue for Apple Object Capture.</p>
				<p>
					<a href="https://github.com/nuit-dhiver/reality-pulse">Source</a>
					&nbsp;·&nbsp;
					<a href="https://github.com/nuit-dhiver/reality-pulse/blob/main/LICENSE">License (GPL v3)</a>
				</p>
			</div>
		</footer>
	</body>
</html>
